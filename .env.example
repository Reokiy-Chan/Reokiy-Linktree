# Admin panel
# Password for the "root" owner account (logs in as username: root).
# ROOT_PASSWORD is preferred; ADMIN_PASSWORD is kept as a fallback for compat.
ADMIN_PASSWORD=change_me
ROOT_PASSWORD=change_me
ADMIN_SECRET=change_me_secret

# Discord status (user must join discord.gg/lanyard to enable live status)
NEXT_PUBLIC_DISCORD_USER_ID=1023628644213587998

# Site URL for SEO (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Fansly live announcements (all optional)
# Discord webhook for "I'm live" messages
FANSLY_DISCORD_WEBHOOK=
# Bluesky: handle + an APP PASSWORD (Settings > App passwords), never your account password
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Browser "notify me" push. Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
